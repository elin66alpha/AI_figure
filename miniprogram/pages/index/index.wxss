.page { padding: 24rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; }
.card.ok { border-left: 8rpx solid #07c160; }
.title { font-size: 34rpx; font-weight: 600; margin-bottom: 12rpx; }
.hint { color: #888; font-size: 26rpx; margin: 8rpx 0 16rpx; }
.warn { color: #e67e22; font-size: 26rpx; margin-top: 12rpx; }
.error { color: #e64340; margin: 12rpx 0 20rpx; }
.field { display: flex; align-items: center; border-bottom: 1rpx solid #eee; padding: 20rpx 0; }
.label { width: 100rpx; color: #333; }
.input { flex: 1; }
.eye { color: #576b95; padding-left: 20rpx; }
.device { display: flex; justify-content: space-between; padding: 28rpx 8rpx; border-bottom: 1rpx solid #eee; }
.device:active { background: #f2f2f2; }
.rssi { color: #999; font-size: 24rpx; }
.step { color: #576b95; margin-top: 12rpx; }
.btn { margin-top: 20rpx; }
.btn.primary { background: #07c160; color: #fff; }
