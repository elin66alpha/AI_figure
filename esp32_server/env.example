# 复制成 /etc/esp32-server.env(VPS)或本机 export 这些变量。
#     sudo install -m 600 -o root -g root env.example /etc/esp32-server.env
# deploy/esp32-server.service 已经用 EnvironmentFile 读这个文件,改完 restart 即可。
#
# 文件名故意不叫 .env.example —— .gitignore 里的 `.env.*` 会把它吃掉。

# ---- 三样各选一家 ----
# ⚠️ systemd 的 EnvironmentFile 不认行尾注释,注释必须独占一行
# ASR:ali / volc    TTS:ali / volc    LLM:qwen / deepseek
ASR_PROVIDER=ali
TTS_PROVIDER=ali
LLM_PROVIDER=qwen

# 回合结束后回什么:echo = 原样送回(Stage 7);asr = 念出识别结果(Stage 9)
REPLY_MODE=echo

# ---- 阿里云百炼(默认,ASR / TTS / Qwen 共用一个 key)----
DASHSCOPE_API_KEY=
# key 是哪个地域的就填哪个:cn = 北京,intl = 国际站(新加坡)。填错握手 401
DASHSCOPE_REGION=cn
ALI_ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
ALI_TTS_MODEL=qwen3-tts-flash-realtime
ALI_TTS_VOICE=Cherry
QWEN_MODEL=qwen3.5-flash-2026-02-23

# ---- DeepSeek(LLM_PROVIDER=deepseek 时才用)----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# ======== 以下是火山(备选),TTS_PROVIDER=volc 时才用 ========

# ---- 火山豆包语音 —— 二选一 ----
VOLC_API_KEY=
# VOLC_APP_ID=
# VOLC_ACCESS_KEY=

# ---- 火山 ASR ----
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# ---- 火山 TTS ----
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# 必须是 2.0 音色列表里的 speaker ID,1.0 的音色在 2.0 资源下会报 45000xxx
VOLC_TTS_SPEAKER=
