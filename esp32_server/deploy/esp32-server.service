# systemd unit —— 回声服务器本体(明文,只监听环回口,公网入口是 stunnel)
#
#     sudo cp esp32-server.service /etc/systemd/system/
#     sudo systemctl daemon-reload && sudo systemctl enable --now esp32-server
#
# 看日志:  journalctl -u esp32-server -f

[Unit]
Description=ESP32-C3 AI Voice — WS 回声/编排服务器
Documentation=https://github.com/elin66alpha/AI_figure
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=esp32
Group=esp32
WorkingDirectory=/opt/esp32_server
Environment=PYTHONUNBUFFERED=1
# 默认就是 127.0.0.1:8765,这里写出来是为了让 `systemctl cat` 一眼能看到实际值。
# **不要**改成 0.0.0.0 —— 这个端口零鉴权,鉴权全在 stunnel 的 PSK 握手上。
Environment=ESP32_SERVER_HOST=127.0.0.1
Environment=ESP32_SERVER_PORT=8765
# Stage 8 起在这里加 .env(火山/DeepSeek 密钥),文件权限记得 600:
# EnvironmentFile=-/etc/esp32-server.env
ExecStart=/opt/esp32_server/.venv/bin/python main.py

Restart=always
RestartSec=2

# --- 加固 ---
# 这个服务只需要读自己的代码目录,别的什么都不需要。
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# 日志只进 journald。SD 卡/小盘 VPS 上别让它往文件里猛写。
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
