#pragma once
// 把这个文件复制成 secrets.h 再填。secrets.h 已在 .gitignore,不会进仓库。
//
//     cp secrets.h.example secrets.h
//
// 填完记得重新编译烧录 —— 串口是纯日志,没有运行期改地址的入口(WiFi 例外,走 BLE 配网)。

// ---------------------------------------------------------------- WiFi
// fw 0.4 起 WiFi 凭据由微信小程序 BLE 配网写进 NVS,这两行**只是开发板的兜底**:
// NVS 里没有凭据时才用它们。两行都删掉(或 SSID 留空)= 没配过网的设备开机直接进配网模式。
// ESP32-C3 只有 2.4 GHz。填 5G 的 SSID 会一直连不上,而且现象和密码错一样。
#define WIFI_SSID       "你的2.4G_SSID"
#define WIFI_PASS       "你的WiFi密码"

// ---------------------------------------------------------------- 服务器
// rev.5:服务器在公网 VPS 上,走 wss://(TLS-PSK)。
// 部署步骤见 esp32_server/deploy/README.md。
//
// **填域名,别填裸 IP。** VPS 换机器/换 IP 的时候,改一条 DNS 记录就行,
// 不用把每台设备都重烧一遍 —— 这台设备没有运行期改地址的入口。
#define SERVER_HOST     "voice.example.com"
#define SERVER_PORT     443
#define SERVER_WS_PATH  "/ws"

// 1 = wss://(TLS-PSK,公网必须);0 = 明文 ws://(只在局域网里直连调试时用)
//
// ⚠️ 这个宏没有默认值 —— 不填的话 net_ws.cpp 会 #error。
// 理由:默默退回明文的话,拿着公网地址裸奔,而且一切看起来都正常。
#define SERVER_USE_TLS  1

// ---------------------------------------------------------------- 设备身份
// 走进 {"t":"hello","dev":...},只用于服务器日志。
// 真正的身份是下面的 PSK_IDENTITY —— 服务器那层看不到它(TLS 在 stunnel 就终结了),
// 所以 hello 里的 dev 只是给人看的,别拿它当鉴权(AGENT.md §7.4)。
#define DEVICE_ID       "c3-01"

// ---------------------------------------------------------------- TLS-PSK
// AGENT.md §5.6 定案:用 PSK 而不是自签/公网 CA。
//   - 省掉 X.509 解析峰值(~20 KB)和证书常驻,握手峰值 ~87 KB -> ~67 KB
//   - **预共享密钥本身就是设备身份**,不必再做一套 token
//   - 不用管证书过期 —— 这台设备没有便捷的远程升级通道
//
// PSK_IDENTITY 要和 VPS 上 /etc/stunnel/psk.secrets 里的冒号左边一字不差。
// PSK_KEY_HEX  是 64 位小写 hex(32 字节)。**64 是上限不是建议值**:
// 设备侧 MBEDTLS_PSK_MAX_LEN 在 TLS1.3 关闭时就是 32 字节,再长 setPreSharedKey() 直接拒。
//
// 生成:  python -c "import secrets;print(secrets.token_hex(32))"
//
// ⚠️ 这把密钥泄了 = 设备可被冒充。别贴进聊天记录/issue/截图。
//    撤销一台设备 = 在 VPS 上删掉 psk.secrets 里对应那一行 + 重启 stunnel。
#define PSK_IDENTITY    "c3-01"
#define PSK_KEY_HEX     "把 64 位 hex 填这里"
